# --- API ---
PORT=8080

# --- AI (後で差し替え。MVPはモックなので未設定でも動く) ---
# GEMINI_API_KEY=
# AI_MODE=mock   # mock | gemini

# --- Elastic（暗黙知の意味検索。未設定でもローカル関連度で動く） ---
# ELASTIC_MODE=on                  # on のときだけ Elastic を使う（既定 off）
# ELASTIC_NODE=https://xxxx.es.<region>.gcp.elastic.cloud:443
# ELASTIC_CLOUD_ID=               # NODE の代わりに Cloud ID でも可
# ELASTIC_API_KEY=
# ELASTIC_RULES_INDEX=complaintops-rules
# ELASTIC_INFERENCE_ID=.elser-2-elasticsearch   # 指定時は semantic_text で意味検索（未指定はBM25）

# --- Web ---
NEXT_PUBLIC_API_BASE=http://localhost:8080
